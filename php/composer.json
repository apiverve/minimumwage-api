        "apiverve",
        "minimumwage",
        "minimum wage",
        "state minimum wage",
        "federal minimum wage",
        "tipped minimum wage",
        "wage rates"
    ],
    "homepage": "https://apiverve.com/marketplace/minimumwage?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/minimumwage",
        "source": "https://github.com/apiverve/minimumwage-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
